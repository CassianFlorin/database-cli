{
  "environments": {
    "qa01": {
      "display_name": "QNVIP QA01",
      "environment": "qa01",
      "project": "qnvip",
      "description": "Shared QA readonly connection; search all visible schemas unless narrowed.",
      "aliases": ["qa-01", "test"],
      "driver": "mysql",
      "host": "mysql-qa01.example.internal",
      "username": "readonly_user",
      "password": "replace-with-local-password",
      "max_rows": 200,
      "limit_style": "limit"
    },
    "prod": {
      "driver": "mysql",
      "host": "mysql-prod.example.internal",
      "username": "readonly_user",
      "password_env": "QNVIP_PROD_DB_PASSWORD",
      "max_rows": 100,
      "limit_style": "limit"
    },
    "qa01_fix": {
      "display_name": "QNVIP QA01 (repair)",
      "description": "Same server as qa01, opted in to user-approved DML. Omit 'writable' to keep an environment read-only.",
      "driver": "mysql",
      "host": "mysql-qa01.example.internal",
      "username": "repair_user",
      "password_env": "QA01_REPAIR_DB_PASSWORD",
      "max_rows": 200,
      "writable": true,
      "max_write_rows": 50,
      "limit_style": "limit"
    }
  },
  "tools": {
    "find_order": {
      "description": "Find one order by order number.",
      "env": "qa01",
      "sql": "SELECT id, order_no, status FROM cc_order WHERE order_no = :order_no",
      "parameters": {
        "order_no": {
          "type": "string",
          "description": "Order number."
        }
      }
    }
  }
}
