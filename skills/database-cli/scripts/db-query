#!/usr/bin/env python3
import argparse
import getpass
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from urllib.parse import parse_qsl, quote, unquote, urlencode, urlparse


DEFAULT_LIMIT = 200
SKILL_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG_PATHS = [
    SKILL_ROOT / "connections.local.json",
    Path.cwd() / "connections.local.json",
    Path.home() / ".config" / "database-cli" / "connections.json",
]
DEFAULT_AUDIT_PATH = Path.home() / ".local" / "state" / "database-cli" / "audit.log"

ALLOWED_FIRST_TOKENS = {"select", "show", "desc", "describe", "explain", "with"}
DML_FIRST_TOKENS = {"insert", "update", "delete", "replace"}
FORBIDDEN_KEYWORDS = {
    "alter",
    "begin",
    "call",
    "commit",
    "copy",
    "create",
    "delete",
    "drop",
    "exec",
    "execute",
    "grant",
    "insert",
    "load",
    "lock",
    "merge",
    "replace",
    "revoke",
    "rollback",
    "set",
    "truncate",
    "unlock",
    "update",
}
FORBIDDEN_PATTERNS = [
    re.compile(r"\bfor\s+update\b", re.I),
    re.compile(r"\binto\s+out(?:file|file)\b", re.I),
    re.compile(r"\binto\s+dumpfile\b", re.I),
    re.compile(r"\b(nextval|setval|get_lock|release_lock|sleep|pg_sleep|benchmark|dblink_exec)\s*\(", re.I),
]


class ConfigError(Exception):
    pass


class UnsafeSqlError(Exception):
    pass


def strip_comments_and_literals(sql):
    out = []
    i = 0
    state = "normal"
    while i < len(sql):
        ch = sql[i]
        nxt = sql[i + 1] if i + 1 < len(sql) else ""

        if state == "normal":
            if ch == "-" and nxt == "-":
                state = "line_comment"
                out.append("  ")
                i += 2
                continue
            if ch == "#":
                state = "line_comment"
                out.append(" ")
                i += 1
                continue
            if ch == "/" and nxt == "*":
                state = "block_comment"
                out.append("  ")
                i += 2
                continue
            if ch == "'":
                state = "single"
                out.append(" ")
                i += 1
                continue
            if ch == '"':
                state = "double"
                out.append(" ")
                i += 1
                continue
            if ch == "`":
                state = "backtick"
                out.append(" ")
                i += 1
                continue
            if ch == "[":
                state = "bracket"
                out.append(" ")
                i += 1
                continue
            out.append(ch)
            i += 1
            continue

        if state == "line_comment":
            if ch in "\r\n":
                state = "normal"
                out.append(ch)
            else:
                out.append(" ")
            i += 1
            continue

        if state == "block_comment":
            if ch == "*" and nxt == "/":
                state = "normal"
                out.append("  ")
                i += 2
            else:
                out.append("\n" if ch in "\r\n" else " ")
                i += 1
            continue

        if state == "single":
            if ch == "'" and nxt == "'":
                out.append("  ")
                i += 2
                continue
            if ch == "'":
                state = "normal"
            out.append(" ")
            i += 1
            continue

        if state == "double":
            if ch == '"' and nxt == '"':
                out.append("  ")
                i += 2
                continue
            if ch == '"':
                state = "normal"
            out.append(" ")
            i += 1
            continue

        if state == "backtick":
            if ch == "`":
                state = "normal"
            out.append(" ")
            i += 1
            continue

        if state == "bracket":
            if ch == "]":
                state = "normal"
            out.append(" ")
            i += 1
            continue

    return "".join(out)


def nonempty_statements(cleaned_sql):
    return [part.strip() for part in cleaned_sql.split(";") if part.strip()]


def first_token(cleaned_sql):
    match = re.search(r"[A-Za-z_][A-Za-z0-9_]*", cleaned_sql)
    return match.group(0).lower() if match else ""


def validate_sql(sql, allow_write=False):
    cleaned = strip_comments_and_literals(sql)
    statements = nonempty_statements(cleaned)
    if len(statements) != 1:
        raise UnsafeSqlError("SQL must contain exactly one statement.")

    statement = statements[0]
    token = first_token(statement)
    allowed_tokens = ALLOWED_FIRST_TOKENS | (DML_FIRST_TOKENS if allow_write else set())
    if token not in allowed_tokens:
        if allow_write:
            allowed = ", ".join(sorted(allowed_tokens))
            raise UnsafeSqlError(f"SQL must start with an allowed token: {allowed}.")
        allowed = ", ".join(sorted(ALLOWED_FIRST_TOKENS))
        raise UnsafeSqlError(f"SQL must start with a read-only token: {allowed}.")

    words = set(re.findall(r"\b[A-Za-z_][A-Za-z0-9_]*\b", statement.lower()))
    if allow_write and token in {"update", "delete"} and "where" not in words:
        raise UnsafeSqlError(f"{token.upper()} requires a WHERE clause when --allow-write is used.")

    forbidden = FORBIDDEN_KEYWORDS - (DML_FIRST_TOKENS if allow_write else set())
    if allow_write and token == "update":
        forbidden = forbidden - {"set"}
    blocked = sorted(words & forbidden)
    if blocked:
        raise UnsafeSqlError(f"SQL contains blocked keyword(s): {', '.join(blocked)}.")

    for pattern in FORBIDDEN_PATTERNS:
        if pattern.search(statement):
            raise UnsafeSqlError(f"SQL contains blocked pattern: {pattern.pattern}.")

    return statement, token


def keyword_span_depth0(cleaned, keyword, search_from=0):
    """Find the first `keyword` at parenthesis depth 0 at/after search_from.

    Operates on comment/literal-stripped, position-preserving text so parens
    inside string literals or subqueries are handled correctly.
    """
    pattern = re.compile(r"\b" + keyword + r"\b", re.I)
    for match in pattern.finditer(cleaned, search_from):
        prefix = cleaned[:match.start()]
        if prefix.count("(") == prefix.count(")"):
            return match.span()
    return None


def parse_write_target(sql, token):
    """Extract (from_expr, where_expr) from an UPDATE/DELETE statement.

    Returns None when the statement has no top-level WHERE, or when the shape
    is not a supported single-statement UPDATE/DELETE (e.g. INSERT/REPLACE).
    Table names, JOINs, and WHERE conditions are sliced from the original SQL,
    so backtick/quoted identifiers are preserved verbatim.
    """
    if token not in {"update", "delete"}:
        return None
    cleaned = strip_comments_and_literals(sql)

    where = keyword_span_depth0(cleaned, "where")
    if not where:
        return None
    where_start, _ = where
    where_expr = sql[where[1]:].strip().rstrip(";").strip()
    if not where_expr:
        return None

    if token == "delete":
        from_span = keyword_span_depth0(cleaned, "from")
        if not from_span or from_span[1] > where_start:
            return None
        from_expr = sql[from_span[1]:where_start].strip()
    else:  # update
        set_span = keyword_span_depth0(cleaned, "set")
        update_span = keyword_span_depth0(cleaned, "update")
        if not set_span or not update_span or set_span[1] > where_start:
            return None
        from_expr = sql[update_span[1]:set_span[0]].strip()

    if not from_expr:
        return None
    return from_expr, where_expr


def simple_table(from_expr):
    """Return a single, unaliased table reference, or None.

    Accepts `t`, `db.t`, and backtick/bracket-quoted variants. Rejects
    JOINs, aliases, comma lists, and subqueries — shapes for which an
    INSERT/UPDATE rollback target would be ambiguous.
    """
    expr = from_expr.strip().rstrip(";").strip()
    if not expr or re.search(r"\s", expr) or "," in expr or "(" in expr:
        return None
    return expr


def bare_column_name(text):
    """Reduce a SET/where target like `` t.`status` `` to `status`."""
    token = text.strip().split(".")[-1].strip().strip("`[]\"")
    match = re.match(r"[\w$]+", token)
    return match.group(0) if match else None


def parse_update_set_columns(sql):
    """Return the bare column names assigned in an UPDATE's SET clause."""
    cleaned = strip_comments_and_literals(sql)
    set_span = keyword_span_depth0(cleaned, "set")
    where_span = keyword_span_depth0(cleaned, "where")
    if not set_span or not where_span or set_span[1] > where_span[0]:
        return None
    region_start, region_end = set_span[1], where_span[0]
    region_cleaned = cleaned[region_start:region_end]

    boundaries = [0]
    depth = 0
    for i, ch in enumerate(region_cleaned):
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == "," and depth == 0:
            boundaries.append(i + 1)
    boundaries.append(len(region_cleaned) + 1)

    columns = []
    for idx in range(len(boundaries) - 1):
        seg_start = boundaries[idx]
        seg_end = boundaries[idx + 1] - 1
        seg_cleaned = region_cleaned[seg_start:seg_end]
        eq = seg_cleaned.find("=")
        if eq == -1:
            return None
        col_original = sql[region_start + seg_start:region_start + seg_start + eq]
        name = bare_column_name(col_original)
        if not name:
            return None
        columns.append(name)
    return columns


def sql_value_literal(value):
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    return sql_literal(str(value))


def key_predicate(column, value):
    if value is None:
        return f"{column} IS NULL"
    return f"{column} = {sql_value_literal(value)}"


def build_update_rollback(table, set_columns, key_columns, rows):
    statements = []
    for row in rows:
        set_parts = []
        for col in set_columns:
            if col not in row:
                raise UnsafeSqlError(
                    f"SET column '{col}' is absent from the snapshot; cannot build a rollback."
                )
            set_parts.append(f"{col} = {sql_value_literal(row[col])}")
        where_parts = []
        for key in key_columns:
            if key not in row:
                raise UnsafeSqlError(
                    f"Key column '{key}' is absent from the snapshot; cannot build a rollback."
                )
            where_parts.append(key_predicate(key, row[key]))
        statements.append(
            f"UPDATE {table} SET {', '.join(set_parts)} WHERE {' AND '.join(where_parts)};"
        )
    return statements


def build_delete_rollback(table, rows):
    statements = []
    for row in rows:
        columns = list(row.keys())
        values = [sql_value_literal(row[col]) for col in columns]
        statements.append(
            f"INSERT INTO {table} ({', '.join(columns)}) VALUES ({', '.join(values)});"
        )
    return statements


def maybe_add_limit(sql, token, limit, limit_style, no_auto_limit):
    return maybe_add_limit_with_cap(sql, token, limit, limit_style, no_auto_limit, None)


def maybe_add_limit_with_cap(sql, token, limit, limit_style, no_auto_limit, hard_limit):
    if limit_style == "none":
        return sql.strip().rstrip(";")
    if token not in {"select", "with"}:
        return sql.strip().rstrip(";")

    requested_limit = limit
    if hard_limit and hard_limit > 0:
        requested_limit = hard_limit if requested_limit <= 0 else min(requested_limit, hard_limit)

    cleaned = strip_comments_and_literals(sql)
    limited_sql = sql.strip().rstrip(";")
    limit_match = re.search(r"\blimit\s+(\d+)\b", cleaned, re.I)
    if limit_match:
        if hard_limit and hard_limit > 0 and int(limit_match.group(1)) > hard_limit:
            start, end = limit_match.span(1)
            return f"{limited_sql[:start]}{hard_limit}{limited_sql[end:]}"
        return limited_sql
    if re.search(r"\bfetch\s+first\b|\btop\b", cleaned, re.I):
        return limited_sql
    if no_auto_limit and not hard_limit:
        return limited_sql
    if requested_limit <= 0:
        return limited_sql
    return f"{limited_sql} LIMIT {requested_limit}"


def sql_literal(value):
    return "'" + str(value).replace("'", "''") + "'"


def append_filter(clauses, column, value, operator="="):
    if value:
        clauses.append(f"{column} {operator} {sql_literal(value)}")


def where_clause(clauses):
    return " WHERE " + " AND ".join(clauses) if clauses else ""


def build_search_objects_sql(env, args):
    driver = env_value(env, "driver", "type").lower()
    if driver not in {"mysql", "mariadb", "postgres", "postgresql"}:
        raise ConfigError(
            "Object search currently supports mysql/mariadb/postgres/postgresql direct configs. "
            "Use --inspect for other drivers or configured sq source handles."
        )

    object_type = args.object_type
    pattern = args.search_objects
    schema_filter = args.schema
    table_filter = args.table
    detail_level = args.detail_level

    if driver in {"mysql", "mariadb"}:
        if object_type == "schema":
            clauses = [f"SCHEMA_NAME LIKE {sql_literal(pattern)}"]
            columns = "SCHEMA_NAME AS schema_name"
            if detail_level in {"summary", "full"}:
                columns += ", DEFAULT_CHARACTER_SET_NAME AS default_character_set_name, DEFAULT_COLLATION_NAME AS default_collation_name"
            return (
                f"SELECT {columns} "
                "FROM INFORMATION_SCHEMA.SCHEMATA"
                f"{where_clause(clauses)} "
                "ORDER BY SCHEMA_NAME"
            )
        if object_type == "table":
            clauses = [f"TABLE_NAME LIKE {sql_literal(pattern)}"]
            append_filter(clauses, "TABLE_SCHEMA", schema_filter)
            if detail_level == "names":
                columns = "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name"
            elif detail_level == "full":
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, TABLE_TYPE AS table_type, "
                    "ENGINE AS engine, TABLE_ROWS AS table_rows, TABLE_COLLATION AS table_collation, "
                    "CREATE_TIME AS create_time, UPDATE_TIME AS update_time, TABLE_COMMENT AS table_comment"
                )
            else:
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, TABLE_TYPE AS table_type, "
                    "TABLE_ROWS AS table_rows, TABLE_COMMENT AS table_comment"
                )
            return (
                f"SELECT {columns} "
                "FROM INFORMATION_SCHEMA.TABLES"
                f"{where_clause(clauses)} "
                "ORDER BY TABLE_SCHEMA, TABLE_NAME"
            )
        if object_type == "column":
            clauses = [f"COLUMN_NAME LIKE {sql_literal(pattern)}"]
            append_filter(clauses, "TABLE_SCHEMA", schema_filter)
            append_filter(clauses, "TABLE_NAME", table_filter)
            if detail_level == "names":
                columns = "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, COLUMN_NAME AS column_name"
            elif detail_level == "full":
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, COLUMN_NAME AS column_name, "
                    "ORDINAL_POSITION AS ordinal_position, DATA_TYPE AS data_type, COLUMN_TYPE AS column_type, "
                    "IS_NULLABLE AS is_nullable, COLUMN_DEFAULT AS column_default, COLUMN_KEY AS column_key, "
                    "EXTRA AS extra, CHARACTER_MAXIMUM_LENGTH AS character_maximum_length, "
                    "NUMERIC_PRECISION AS numeric_precision, COLUMN_COMMENT AS column_comment"
                )
            else:
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, COLUMN_NAME AS column_name, "
                    "DATA_TYPE AS data_type, COLUMN_TYPE AS column_type, IS_NULLABLE AS is_nullable, "
                    "COLUMN_KEY AS column_key, COLUMN_COMMENT AS column_comment"
                )
            return (
                f"SELECT {columns} "
                "FROM INFORMATION_SCHEMA.COLUMNS"
                f"{where_clause(clauses)} "
                "ORDER BY TABLE_SCHEMA, TABLE_NAME, ORDINAL_POSITION"
            )
        if object_type == "index":
            clauses = [f"INDEX_NAME LIKE {sql_literal(pattern)}"]
            append_filter(clauses, "TABLE_SCHEMA", schema_filter)
            append_filter(clauses, "TABLE_NAME", table_filter)
            if detail_level == "names":
                columns = "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, INDEX_NAME AS index_name"
            elif detail_level == "full":
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, INDEX_NAME AS index_name, "
                    "COLUMN_NAME AS column_name, NON_UNIQUE AS non_unique, SEQ_IN_INDEX AS seq_in_index, "
                    "INDEX_TYPE AS index_type, CARDINALITY AS cardinality, SUB_PART AS sub_part, "
                    "COLLATION AS collation, NULLABLE AS nullable, INDEX_COMMENT AS index_comment"
                )
            else:
                columns = (
                    "TABLE_SCHEMA AS table_schema, TABLE_NAME AS table_name, INDEX_NAME AS index_name, "
                    "COLUMN_NAME AS column_name, NON_UNIQUE AS non_unique, SEQ_IN_INDEX AS seq_in_index"
                )
            return (
                f"SELECT {columns} "
                "FROM INFORMATION_SCHEMA.STATISTICS"
                f"{where_clause(clauses)} "
                "ORDER BY TABLE_SCHEMA, TABLE_NAME, INDEX_NAME, SEQ_IN_INDEX"
            )
        if object_type in {"procedure", "function"}:
            clauses = [f"ROUTINE_NAME LIKE {sql_literal(pattern)}"]
            append_filter(clauses, "ROUTINE_SCHEMA", schema_filter)
            clauses.append(f"ROUTINE_TYPE = {sql_literal(object_type.upper())}")
            if detail_level == "names":
                columns = "ROUTINE_SCHEMA AS routine_schema, ROUTINE_NAME AS routine_name, ROUTINE_TYPE AS routine_type"
            elif detail_level == "full":
                columns = (
                    "ROUTINE_SCHEMA AS routine_schema, ROUTINE_NAME AS routine_name, ROUTINE_TYPE AS routine_type, "
                    "DATA_TYPE AS data_type, CREATED AS created, LAST_ALTERED AS last_altered, "
                    "SECURITY_TYPE AS security_type, DEFINER AS definer, SQL_MODE AS sql_mode, "
                    "ROUTINE_COMMENT AS routine_comment, ROUTINE_DEFINITION AS routine_definition"
                )
            else:
                columns = (
                    "ROUTINE_SCHEMA AS routine_schema, ROUTINE_NAME AS routine_name, "
                    "ROUTINE_TYPE AS routine_type, DATA_TYPE AS data_type, CREATED AS created, "
                    "LAST_ALTERED AS last_altered"
                )
            return (
                f"SELECT {columns} "
                "FROM INFORMATION_SCHEMA.ROUTINES"
                f"{where_clause(clauses)} "
                "ORDER BY ROUTINE_SCHEMA, ROUTINE_NAME"
            )

    if object_type == "schema":
        clauses = [f"schema_name LIKE {sql_literal(pattern)}"]
        columns = "schema_name"
        if detail_level in {"summary", "full"}:
            columns += ", catalog_name, schema_owner"
        return (
            f"SELECT {columns} "
            "FROM information_schema.schemata"
            f"{where_clause(clauses)} "
            "ORDER BY schema_name"
        )
    if object_type == "table":
        clauses = [f"table_name LIKE {sql_literal(pattern)}"]
        append_filter(clauses, "table_schema", schema_filter)
        if detail_level == "names":
            columns = "table_schema, table_name"
        elif detail_level == "full":
            columns = "table_schema, table_name, table_type, self_referencing_column_name, reference_generation"
        else:
            columns = "table_schema, table_name, table_type"
        return (
            f"SELECT {columns} "
            "FROM information_schema.tables"
            f"{where_clause(clauses)} "
            "ORDER BY table_schema, table_name"
        )
    if object_type == "column":
        clauses = [f"column_name LIKE {sql_literal(pattern)}"]
        append_filter(clauses, "table_schema", schema_filter)
        append_filter(clauses, "table_name", table_filter)
        if detail_level == "names":
            columns = "table_schema, table_name, column_name"
        elif detail_level == "full":
            columns = (
                "table_schema, table_name, column_name, ordinal_position, column_default, "
                "is_nullable, data_type, character_maximum_length, numeric_precision, udt_name"
            )
        else:
            columns = "table_schema, table_name, column_name, data_type, is_nullable"
        return (
            f"SELECT {columns} "
            "FROM information_schema.columns"
            f"{where_clause(clauses)} "
            "ORDER BY table_schema, table_name, ordinal_position"
        )
    if object_type == "index":
        clauses = [f"indexname LIKE {sql_literal(pattern)}"]
        append_filter(clauses, "schemaname", schema_filter)
        append_filter(clauses, "tablename", table_filter)
        if detail_level == "names":
            columns = "schemaname AS table_schema, tablename AS table_name, indexname AS index_name"
        else:
            columns = (
                "schemaname AS table_schema, tablename AS table_name, indexname AS index_name, "
                "indexdef AS index_definition"
            )
        return (
            f"SELECT {columns} "
            "FROM pg_catalog.pg_indexes"
            f"{where_clause(clauses)} "
            "ORDER BY schemaname, tablename, indexname"
        )
    if object_type in {"procedure", "function"}:
        clauses = [f"routine_name LIKE {sql_literal(pattern)}"]
        append_filter(clauses, "routine_schema", schema_filter)
        clauses.append(f"routine_type = {sql_literal(object_type.upper())}")
        if detail_level == "names":
            columns = "routine_schema, routine_name, routine_type"
        elif detail_level == "full":
            columns = (
                "routine_schema, routine_name, routine_type, data_type, type_udt_name, "
                "external_language, security_type, is_null_call, routine_definition"
            )
        else:
            columns = "routine_schema, routine_name, routine_type, data_type"
        return (
            f"SELECT {columns} "
            "FROM information_schema.routines"
            f"{where_clause(clauses)} "
            "ORDER BY routine_schema, routine_name"
        )

    raise ConfigError(f"Unsupported object type '{object_type}'.")


def config_paths(explicit_path):
    if explicit_path:
        return [Path(explicit_path).expanduser()]
    env_path = os.environ.get("DATABASE_CLI_CONFIG")
    if env_path:
        return [Path(env_path).expanduser()]
    return DEFAULT_CONFIG_PATHS


def load_config(explicit_path):
    for path in config_paths(explicit_path):
        if path.exists():
            with path.open("r", encoding="utf-8") as handle:
                return json.load(handle), path
    paths = ", ".join(str(path) for path in config_paths(explicit_path))
    raise ConfigError(f"No config file found. Checked: {paths}")


def parse_database_url(raw_url):
    if not raw_url:
        return {}
    if "://" not in raw_url:
        return {"host": raw_url}

    parsed = urlparse(raw_url)
    values = {}
    if parsed.scheme:
        scheme = parsed.scheme.lower()
        values["driver"] = "sqlite3" if scheme == "sqlite" else scheme
    if parsed.hostname:
        values["host"] = parsed.hostname
    if parsed.port:
        values["port"] = parsed.port
    if parsed.username:
        values["username"] = unquote(parsed.username)
    if parsed.password:
        values["password"] = unquote(parsed.password)

    path = unquote(parsed.path.lstrip("/"))
    if path:
        if values.get("driver") in {"sqlite3", "duckdb"}:
            values["path"] = unquote(parsed.path)
        else:
            values["database"] = path

    params = {key: value for key, value in parse_qsl(parsed.query, keep_blank_values=True)}
    if params:
        values["params"] = params
    return values


AD_HOC_CONNECTION_FIELDS = {
    "url",
    "driver",
    "host",
    "port",
    "database",
    "path",
    "username",
    "password",
    "password_env",
}


def has_ad_hoc_connection(args):
    return any(getattr(args, field, None) not in (None, "") for field in AD_HOC_CONNECTION_FIELDS)


def build_ad_hoc_env(args):
    parsed = parse_database_url(args.url)
    values = dict(parsed)
    for field in AD_HOC_CONNECTION_FIELDS - {"url"}:
        value = getattr(args, field, None)
        if value not in (None, ""):
            values[field] = value
    if args.schema:
        values["schema"] = args.schema
    if args.max_rows is not None:
        values["max_rows"] = args.max_rows

    driver = str(values.get("driver") or "mysql").lower()
    values["driver"] = driver
    if driver in {"sqlite", "sqlite3", "duckdb"}:
        if not values.get("path") and not values.get("database"):
            raise ConfigError("Ad-hoc sqlite3/duckdb connections require --path or a file URL.")
    elif not values.get("host"):
        raise ConfigError("Ad-hoc database connections require --url or --host.")
    return values


def runtime_connection(args):
    if args.env:
        config, path = load_config(args.config)
        env_name, env = get_env(config, args.env)
        return config, path, env_name, env
    if has_ad_hoc_connection(args):
        env = build_ad_hoc_env(args)
        return {}, None, "adhoc", env
    raise ConfigError("Missing --env or ad-hoc connection details. Use --list-envs or provide --url/--host with credentials.")


def setup_status(args):
    checked_paths = [str(path) for path in config_paths(args.config)]
    config = None
    config_path = None
    config_error = None
    ad_hoc_error = None

    for path in config_paths(args.config):
        if path.exists():
            config_path = path
            try:
                with path.open("r", encoding="utf-8") as handle:
                    config = json.load(handle)
            except json.JSONDecodeError as exc:
                config_error = str(exc)
            break

    if has_ad_hoc_connection(args):
        try:
            envs = {"adhoc": build_ad_hoc_env(args)}
        except ConfigError as exc:
            envs = {}
            ad_hoc_error = str(exc)
    elif isinstance(config, dict):
        envs = config.get("environments", {}) or {}
        if not isinstance(envs, dict):
            envs = {}
    else:
        envs = {}

    sq_available = shutil.which(args.sq_bin) is not None
    problems = []
    if not sq_available:
        problems.append(
            {
                "code": "missing_sq",
                "message": f"'{args.sq_bin}' is not available. Install sq before running real database queries.",
            }
        )
    if ad_hoc_error:
        problems.append(
            {
                "code": "invalid_ad_hoc_connection",
                "message": ad_hoc_error,
            }
        )
    if config_path is None and not has_ad_hoc_connection(args):
        problems.append(
            {
                "code": "missing_config",
                "message": "No database-cli connection config was found.",
            }
        )
    elif config_error and not has_ad_hoc_connection(args):
        problems.append(
            {
                "code": "invalid_config",
                "message": f"Config JSON is invalid: {config_error}",
            }
        )
    elif not envs:
        problems.append(
            {
                "code": "no_environments",
                "message": "Connection config exists but has no environments.",
            }
        )

    connections = [
        connection_summary(name, envs[name])
        for name in sorted(envs)
    ]
    ready = sq_available and not ad_hoc_error and (has_ad_hoc_connection(args) or (config_path is not None and not config_error)) and bool(envs)

    next_actions = []
    if ready:
        next_actions.extend(
            [
                {
                    "label": "List configured environments",
                    "command": "scripts/db-query --list-envs",
                },
                {
                    "label": "Run a minimal read-only smoke query after confirming the target environment",
                    "command": "scripts/db-query --env <env> --sql \"SELECT 1\"",
                },
            ]
        )
    else:
        if not sq_available:
            next_actions.append(
                {
                    "label": "Install sq",
                    "command": "brew install sq",
                }
            )
        if (config_path is None and not has_ad_hoc_connection(args)) or not envs:
            next_actions.append(
                {
                    "label": "Create the first read-only connection",
                    "command": (
                        "scripts/install --env <env> --url <database-url-or-host> "
                        "--username <readonly-user> --password-env <ENV_DB_PASSWORD> --non-interactive"
                    ),
                }
            )

    status = {
        "ready": ready,
        "sq_available": sq_available,
        "config": {
            "exists": config_path is not None and config_error is None,
            "path": str(config_path) if config_path else checked_paths[0],
            "checked_paths": checked_paths,
            "required": not has_ad_hoc_connection(args),
        },
        "environments": sorted(envs),
        "connections": connections,
        "problems": problems,
        "next_actions": next_actions,
        "agent_guidance": [
            "Start with setup_status before asking the user for database details.",
            "If ready is false, ask only for the facts needed by next_actions.",
            "Use search_objects for metadata discovery before querying table data.",
            "Use query_readonly or scripts/db-query for bounded read-only SQL only; output repair SQL for humans to execute.",
        ],
    }
    return status


def get_env(config, env_name):
    envs = config.get("environments", {})
    canonical_name = resolve_env_name(config, env_name)
    env = envs[canonical_name]
    if not env.get("source") and not env.get("driver"):
        raise ConfigError(
            f"Environment '{canonical_name}' must define either 'source' or direct connection fields."
        )
    return canonical_name, env


def alias_values(env):
    aliases = env.get("aliases", [])
    if isinstance(aliases, str):
        return [aliases]
    if isinstance(aliases, list):
        return [str(alias) for alias in aliases if str(alias)]
    return []


def resolve_env_name(config, requested):
    envs = config.get("environments", {})
    if requested in envs:
        return requested
    matches = [
        name
        for name, env in envs.items()
        if requested in alias_values(env)
    ]
    if len(matches) == 1:
        return matches[0]
    available = ", ".join(sorted(envs)) or "(none)"
    if len(matches) > 1:
        matched = ", ".join(sorted(matches))
        raise ConfigError(f"Environment alias '{requested}' is ambiguous: {matched}. Available: {available}")
    raise ConfigError(f"Unknown environment '{requested}'. Available: {available}")


SAFE_CONNECTION_FIELDS = [
    "display_name",
    "environment",
    "project",
    "description",
    "aliases",
    "driver",
    "type",
    "host",
    "port",
    "database",
    "schema",
    "source",
    "max_rows",
    "readonly",
    "limit_style",
]


def connection_summary(name, env):
    summary = {"name": name}
    for field in SAFE_CONNECTION_FIELDS:
        if field in env and env[field] not in (None, ""):
            summary[field] = env[field]
    if "aliases" in summary:
        summary["aliases"] = alias_values(env)
    if "readonly" not in summary:
        summary["readonly"] = True
    return summary


def bool_value(value, default=True):
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() not in {"0", "false", "no", "off"}


def positive_int(value):
    if value in (None, ""):
        return 0
    try:
        number = int(value)
    except (TypeError, ValueError) as exc:
        raise ConfigError(f"Expected a positive integer, got {value!r}.") from exc
    return number if number > 0 else 0


def enforce_readonly(config, env, env_name):
    if not bool_value(config.get("readonly"), True):
        raise ConfigError("Top-level readonly=false is not supported; database-cli only runs read-only queries.")
    if not bool_value(env.get("readonly"), True):
        raise ConfigError(f"Environment '{env_name}' sets readonly=false; database-cli only runs read-only queries.")


def configured_max_rows(config, env):
    limits = []
    for value in (config.get("max_rows"), env.get("max_rows")):
        limit = positive_int(value)
        if limit:
            limits.append(limit)
    return min(limits) if limits else 0


def env_value(env, *names):
    for name in names:
        if name in env and env[name] not in (None, ""):
            return str(env[name])
    return ""


def password_value(env):
    if env.get("password_env"):
        env_name = str(env["password_env"])
        password = os.environ.get(env_name)
        if password is None:
            raise ConfigError(f"Password environment variable '{env_name}' is not set.")
        return password
    return env_value(env, "password", "pass")


def build_auth(username, password, include_password=True):
    if not username:
        return ""
    auth = quote(username, safe="")
    if password and include_password:
        auth += f":{quote(password, safe='')}"
    return f"{auth}@"


MYSQL_PARAM_KEYS = {
    "allowAllFiles",
    "allowCleartextPasswords",
    "allowFallbackToPlaintext",
    "allowNativePasswords",
    "allowOldPasswords",
    "charset",
    "checkConnLiveness",
    "clientFoundRows",
    "collation",
    "columnsWithAlias",
    "compress",
    "interpolateParams",
    "loc",
    "maxAllowedPacket",
    "multiStatements",
    "parseTime",
    "readTimeout",
    "rejectReadOnly",
    "serverPubKey",
    "timeout",
    "timeTruncate",
    "tls",
    "writeTimeout",
}

POSTGRES_PARAM_KEYS = {
    "application_name",
    "connect_timeout",
    "fallback_application_name",
    "gssencmode",
    "krbsrvname",
    "options",
    "passfile",
    "requirepeer",
    "service",
    "sslcert",
    "sslcompression",
    "sslcrl",
    "sslkey",
    "sslmode",
    "sslrootcert",
    "target_session_attrs",
}


def filter_params(driver, params):
    if driver in {"mysql", "mariadb"}:
        return {key: value for key, value in params.items() if key in MYSQL_PARAM_KEYS}
    if driver in {"postgres", "postgresql"}:
        return {key: value for key, value in params.items() if key in POSTGRES_PARAM_KEYS}
    return params


def build_params(env, driver):
    params = dict(env.get("params", {}))
    for key in ("sslmode", "ssl-mode", "charset", "timezone"):
        if env.get(key):
            params[key] = env[key]
    params = filter_params(driver, params)
    return f"?{urlencode(params)}" if params else ""


def host_port(host, port):
    return f"{host}:{port}" if port else host


def build_direct_dsn(env, include_password=True):
    driver = env_value(env, "driver", "type").lower()
    database = env_value(env, "database", "db")
    path = env_value(env, "path", "file")
    username = env_value(env, "username", "user")
    password = password_value(env)
    params = build_params(env, driver)

    if driver in {"sqlite", "sqlite3"}:
        if not path and not database:
            raise ConfigError("SQLite config requires 'path' or 'database'.")
        sqlite_path = quote(path or database, safe="/:")
        return f"sqlite3:///{sqlite_path}{params}"

    if driver == "duckdb":
        if not path and not database:
            raise ConfigError("DuckDB config requires 'path' or 'database'.")
        duckdb_path = quote(path or database, safe="/:")
        return f"duckdb:///{duckdb_path}{params}"

    if driver in {"mysql", "mariadb"}:
        host = env_value(env, "host")
        port = env_value(env, "port")
        if not host:
            raise ConfigError("MySQL config requires 'host'.")
        path = f"/{quote(database, safe='')}" if database else ""
        return f"mysql://{build_auth(username, password, include_password)}{host_port(host, port)}{path}{params}"

    if driver in {"postgres", "postgresql"}:
        host = env_value(env, "host")
        port = env_value(env, "port")
        if not host:
            raise ConfigError("Postgres config requires 'host'.")
        path = f"/{quote(database, safe='')}" if database else ""
        return f"postgres://{build_auth(username, password, include_password)}{host_port(host, port)}{path}{params}"

    if driver == "sqlserver":
        host = env_value(env, "host")
        port = env_value(env, "port")
        if not host:
            raise ConfigError("SQL Server config requires 'host'.")
        query = dict(env.get("params", {}))
        if database:
            query.setdefault("database", database)
        query_string = f"?{urlencode(query)}" if query else ""
        return f"sqlserver://{build_auth(username, password, include_password)}{host_port(host, port)}{query_string}"

    if driver == "clickhouse":
        host = env_value(env, "host")
        port = env_value(env, "port")
        if not host:
            raise ConfigError("ClickHouse config requires 'host'.")
        path = f"/{quote(database, safe='')}" if database else ""
        return f"clickhouse://{build_auth(username, password, include_password)}{host_port(host, port)}{path}{params}"

    raise ConfigError(f"Unsupported direct driver '{driver}'. Use source for custom sq handles.")


def redact(text, secrets):
    redacted = text
    for secret in secrets:
        if secret:
            redacted = redacted.replace(secret, "***")
    return redacted


def env_secrets(env):
    return [password_value(env)]


def audit_enabled(args, config, env):
    if getattr(args, "no_audit", False):
        return False
    for scope in (env, config):
        if isinstance(scope, dict) and "audit" in scope:
            return bool_value(scope.get("audit"), True)
    return True


def resolve_audit_path(args, config, env):
    explicit = getattr(args, "audit_log", None)
    if explicit:
        return Path(explicit).expanduser()
    env_path = os.environ.get("DATABASE_CLI_AUDIT_LOG")
    if env_path:
        return Path(env_path).expanduser()
    for scope in (env, config):
        if isinstance(scope, dict) and scope.get("audit_log"):
            return Path(str(scope["audit_log"])).expanduser()
    return DEFAULT_AUDIT_PATH


def audit_user():
    try:
        return getpass.getuser()
    except Exception:
        return os.environ.get("USER") or os.environ.get("USERNAME") or "unknown"


def write_audit(path, entry):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as exc:
        print(f"db-query: audit log write failed: {exc}", file=sys.stderr)


def emit_audit(args, config, env, env_name, *, event, statement, token, allow_write, exit_code, duration_ms, extra=None):
    if not audit_enabled(args, config, env):
        return
    entry = {
        "ts": datetime.now().astimezone().isoformat(timespec="milliseconds"),
        "event": event,
        "env": None if env_name == "adhoc" else env_name,
        "adhoc": env_name == "adhoc",
        # Only the "sql" event actually executes the statement; preview_write
        # and generate_rollback analyze a DML token but run read-only SELECTs.
        "mode": "write" if event == "sql" and token in DML_FIRST_TOKENS else "read",
        "token": token,
        "statement": redact(statement, env_secrets(env)) if statement else statement,
        "allow_write": bool(allow_write),
        "exit_code": exit_code,
        "duration_ms": duration_ms,
        "user": audit_user(),
        "pid": os.getpid(),
    }
    if extra:
        entry.update(extra)
    write_audit(resolve_audit_path(args, config, env), entry)


def source_handle_for(env_name):
    suffix = re.sub(r"[^A-Za-z0-9_]+", "_", env_name).strip("_") or "default"
    return f"@database_cli_{suffix}"


def output_flags(fmt):
    return {
        "json": ["--json", "--compact"],
        "csv": ["--csv"],
        "markdown": ["--markdown"],
        "text": ["--text"],
        "yaml": ["--yaml"],
    }[fmt]


def base_sq_command(args, config, env, require_executable=True, sq_config_override=None):
    sq_bin = args.sq_bin
    if require_executable and not shutil.which(sq_bin):
        raise ConfigError(f"Missing '{sq_bin}' executable. Install with: brew install sq")

    cmd = [sq_bin]
    sq_config = sq_config_override or env.get("sq_config") or config.get("sq_config")
    if sq_config:
        cmd.extend(["--config", sq_config])
    cmd.extend(["--no-progress", "--error.format", "text"])
    return cmd


def build_sql_command(args, config, env, sql, source, sq_config_override=None, fmt=None):
    cmd = base_sq_command(
        args,
        config,
        env,
        require_executable=not args.print_command,
        sq_config_override=sq_config_override,
    )
    cmd.append("sql")
    cmd.extend(["--src", source])
    schema = args.schema or env.get("schema")
    if schema:
        cmd.extend(["--src.schema", schema])
    cmd.extend(output_flags(fmt or args.format))
    cmd.append(sql)
    return cmd


def build_inspect_command(args, config, env, source, sq_config_override=None):
    cmd = base_sq_command(
        args,
        config,
        env,
        require_executable=not args.print_command,
        sq_config_override=sq_config_override,
    )
    cmd.append("inspect")
    cmd.extend(output_flags(args.format))
    schema = args.schema or env.get("schema")
    if schema:
        cmd.extend(["--src.schema", schema])
    target = args.inspect
    if target:
        if target.startswith("@") or target.startswith("."):
            cmd.append(target)
        else:
            cmd.append(f"{source}.{target}")
    else:
        cmd.append(source)
    return cmd


def run_command(cmd, timeout, secrets=None):
    proc = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, check=False)
    secrets = secrets or []
    if proc.stdout:
        sys.stdout.write(redact(proc.stdout, secrets))
    if proc.stderr:
        sys.stderr.write(redact(proc.stderr, secrets))
    return proc.returncode


def run_capture(cmd, timeout, secrets=None):
    proc = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, check=False)
    secrets = secrets or []
    return proc.returncode, redact(proc.stdout, secrets), redact(proc.stderr, secrets)


def run_internal_command(cmd, timeout, secrets, input_text=None):
    proc = subprocess.run(
        cmd,
        text=True,
        input=input_text,
        capture_output=True,
        timeout=timeout,
        check=False,
    )
    if proc.returncode != 0:
        if proc.stdout:
            sys.stderr.write(redact(proc.stdout, secrets))
        if proc.stderr:
            sys.stderr.write(redact(proc.stderr, secrets))
    return proc.returncode


def prepare_source(args, config, env, env_name):
    if env.get("source"):
        return env["source"], None, None

    if not shutil.which(args.sq_bin) and not args.print_command:
        raise ConfigError(f"Missing '{args.sq_bin}' executable. Install with: brew install sq")

    password = password_value(env)
    dsn = build_direct_dsn(env, include_password=args.print_command)
    handle = source_handle_for(env_name)

    if args.print_command:
        prefix = ""
        add_dsn = dsn
        if password:
            add_dsn = build_direct_dsn(env, include_password=False)
            prefix = "printf '***\\n' | "
        add_cmd = [
            args.sq_bin,
            "--config",
            "<temporary-sq-config>",
            "--no-progress",
            "--error.format",
            "text",
            "add",
            dsn,
            "--handle",
            handle,
        ]
        if password:
            add_cmd[-3] = add_dsn
            add_cmd.append("--password")
            return handle, "<temporary-sq-config>", (prefix, add_cmd)
        return handle, "<temporary-sq-config>", add_cmd

    tmpdir = tempfile.TemporaryDirectory(prefix="database-cli-sq-")
    sq_config = str(Path(tmpdir.name) / "sq.yml")
    add_dsn = build_direct_dsn(env, include_password=False if password else True)
    add_cmd = [
        args.sq_bin,
        "--config",
        sq_config,
        "--no-progress",
        "--error.format",
        "text",
        "add",
        add_dsn,
        "--handle",
        handle,
    ]
    input_text = None
    if password:
        add_cmd.append("--password")
        input_text = f"{password}\n"
    rc = run_internal_command(add_cmd, args.timeout, env_secrets(env), input_text=input_text)
    if rc != 0:
        tmpdir.cleanup()
        raise ConfigError(f"Failed to create temporary sq source for environment '{env_name}'.")
    return handle, sq_config, tmpdir


def parse_args():
    parser = argparse.ArgumentParser(description="Run safe read-only database CLI queries through sq.")
    parser.add_argument("--config", help="Path to connections JSON.")
    parser.add_argument("--env", help="Configured environment name.")
    parser.add_argument("--url", help="Ad-hoc database URL or host/domain supplied by the user.")
    parser.add_argument("--driver", choices=["mysql", "mariadb", "postgres", "postgresql", "sqlite3", "duckdb", "sqlserver", "clickhouse"], help="Ad-hoc database driver. Defaults to mysql when --host or a host-only --url is used.")
    parser.add_argument("--host", help="Ad-hoc database host/domain.")
    parser.add_argument("--port", type=int, help="Ad-hoc database port.")
    parser.add_argument("--database", help="Ad-hoc default database/catalog.")
    parser.add_argument("--path", help="Ad-hoc SQLite/DuckDB file path.")
    parser.add_argument("--username", help="Ad-hoc database username.")
    parser.add_argument("--password", help="Ad-hoc local password; prefer --password-env when possible.")
    parser.add_argument("--password-env", help="Environment variable containing the ad-hoc database password.")
    parser.add_argument("--schema", help="Override schema/catalog for this call.")
    parser.add_argument("--sql", help="Read-only SQL statement to execute.")
    parser.add_argument("--check-sql", help="Validate SQL safety without executing.")
    parser.add_argument("--preview-write", help="Preview an UPDATE/DELETE's impact without executing it: reports affected-row count and a bounded before-snapshot of the matched rows.")
    parser.add_argument("--generate-rollback", help="Generate (do not execute) rollback SQL for an UPDATE/DELETE from the current before-image. UPDATE restores old values; DELETE re-inserts the rows.")
    parser.add_argument("--key-columns", help="Comma-separated key column(s) that uniquely identify a row, used to scope UPDATE rollback statements. Required with --generate-rollback for UPDATE.")
    parser.add_argument("--inspect", nargs="?", const="", help="Inspect a source or table.")
    parser.add_argument("--search-objects", help="Search schema/table/column/index/procedure metadata with a SQL LIKE pattern.")
    parser.add_argument("--object-type", choices=["schema", "table", "column", "index", "procedure", "function"], default="table")
    parser.add_argument("--detail-level", choices=["names", "summary", "full"], default="summary")
    parser.add_argument("--table", help="Limit column/index metadata search to one table.")
    parser.add_argument("--setup-status", action="store_true", help="Print Agent-friendly setup status and next actions without querying a database.")
    parser.add_argument("--list-envs", action="store_true", help="List configured environments.")
    parser.add_argument("--format", choices=["json", "csv", "markdown", "text", "yaml"], default="json")
    parser.add_argument("--limit", type=int, default=DEFAULT_LIMIT, help="Default row limit for SELECT/WITH queries.")
    parser.add_argument("--max-rows", type=int, help="Hard maximum rows for ad-hoc SELECT/WITH queries.")
    parser.add_argument("--no-auto-limit", action="store_true", help="Do not append LIMIT to SELECT/WITH queries.")
    parser.add_argument("--allow-write", action="store_true", help="Allow DML SQL after explicit user approval. DDL, transactions, procedures, locks, exports, and other side effects remain blocked.")
    parser.add_argument("--print-command", action="store_true", help="Print the sq command instead of executing it.")
    parser.add_argument("--audit-log", help="Path to the append-only audit log. Overrides DATABASE_CLI_AUDIT_LOG and config 'audit_log'.")
    parser.add_argument("--no-audit", action="store_true", help="Disable audit logging for this call.")
    parser.add_argument("--sq-bin", default="sq", help="sq executable path or name.")
    parser.add_argument("--timeout", type=int, default=60, help="Command timeout in seconds.")
    return parser.parse_args()


def parse_count_result(stdout):
    try:
        rows = json.loads(stdout)
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(rows, list) or not rows or not isinstance(rows[0], dict):
        return None
    row = rows[0]
    if "affected_rows" in row:
        value = row["affected_rows"]
    else:
        value = next(iter(row.values()), None)
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def derive_impact_sql(args, env, from_expr, where_expr, max_rows):
    """Build read-only COUNT and before-snapshot SELECTs for a write target."""
    count_sql = f"SELECT COUNT(*) AS affected_rows FROM {from_expr} WHERE {where_expr}"
    snapshot_sql = f"SELECT * FROM {from_expr} WHERE {where_expr}"
    validate_sql(count_sql, allow_write=False)
    validate_sql(snapshot_sql, allow_write=False)
    limit_style = env.get("limit_style", "limit")
    snapshot_sql = maybe_add_limit_with_cap(
        snapshot_sql, "select", args.limit, limit_style, args.no_auto_limit, max_rows
    )
    return count_sql, snapshot_sql


def print_setup_prefix(setup, env):
    if isinstance(setup, tuple):
        prefix, setup_cmd = setup
        print(prefix + redact(shlex.join(setup_cmd), env_secrets(env)))
        print("&&")
    elif isinstance(setup, list):
        print(redact(shlex.join(setup), env_secrets(env)))
        print("&&")


def run_impact(count_cmd, snapshot_cmd, secrets, timeout):
    """Run COUNT then before-snapshot. Returns (rc, affected, rows, err_text)."""
    count_rc, count_out, count_err = run_capture(count_cmd, timeout, secrets)
    if count_rc != 0:
        return count_rc, None, None, (count_err or count_out)
    affected = parse_count_result(count_out)
    snap_rc, snap_out, snap_err = run_capture(snapshot_cmd, timeout, secrets)
    if snap_rc != 0:
        return snap_rc, affected, None, (snap_err or snap_out)
    try:
        rows = json.loads(snap_out)
    except json.JSONDecodeError:
        rows = []
    return 0, affected, rows, None


def parse_write_or_raise(statement, flag_name):
    _, token = validate_sql(statement, allow_write=True)
    if token not in {"update", "delete"}:
        raise UnsafeSqlError(f"{flag_name} supports UPDATE and DELETE statements only.")
    target = parse_write_target(statement, token)
    if not target:
        raise UnsafeSqlError(
            "Could not extract a top-level WHERE target from the statement. "
            f"{flag_name} supports single-statement UPDATE/DELETE with a WHERE clause."
        )
    return token, target[0], target[1]


def preview_write(args, config, env, env_name, max_rows):
    token, from_expr, where_expr = parse_write_or_raise(args.preview_write, "--preview-write")
    count_sql, snapshot_sql = derive_impact_sql(args, env, from_expr, where_expr, max_rows)

    source, sq_config, setup = prepare_source(args, config, env, env_name)
    try:
        count_cmd = build_sql_command(args, config, env, count_sql, source, sq_config, fmt="json")
        snapshot_cmd = build_sql_command(args, config, env, snapshot_sql, source, sq_config, fmt="json")

        if args.print_command:
            print_setup_prefix(setup, env)
            print(shlex.join(count_cmd))
            print(shlex.join(snapshot_cmd))
            return 0

        secrets = env_secrets(env)
        start = datetime.now()
        exit_code = None
        affected = None
        try:
            rc, affected, rows, err = run_impact(count_cmd, snapshot_cmd, secrets, args.timeout)
            if rc != 0:
                sys.stderr.write(err or "")
                exit_code = rc
                return rc
            truncated = bool(max_rows and affected is not None and affected > len(rows))
            envelope = {
                "preview": True,
                "token": token,
                "from": from_expr,
                "where": where_expr,
                "affected_rows": affected,
                "snapshot_rows": len(rows),
                "snapshot_truncated": truncated,
                "count_sql": count_sql,
                "snapshot_sql": snapshot_sql,
                "snapshot": rows,
            }
            print(json.dumps(envelope, ensure_ascii=False))
            exit_code = 0
            return 0
        finally:
            emit_audit(
                args, config, env, env_name,
                event="preview_write",
                statement=args.preview_write,
                token=token,
                allow_write=False,
                exit_code=exit_code,
                duration_ms=round((datetime.now() - start).total_seconds() * 1000, 1),
                extra={"affected_rows": affected},
            )
    finally:
        if isinstance(setup, tempfile.TemporaryDirectory):
            setup.cleanup()


def generate_rollback(args, config, env, env_name, max_rows):
    token, from_expr, where_expr = parse_write_or_raise(args.generate_rollback, "--generate-rollback")
    table = simple_table(from_expr)
    if not table:
        raise UnsafeSqlError(
            "Rollback requires a single, unaliased target table (no JOIN, alias, or subquery)."
        )

    key_columns = []
    set_columns = None
    if token == "update":
        if not args.key_columns:
            raise UnsafeSqlError(
                "UPDATE rollback requires --key-columns to scope each restore statement "
                "to exact rows (e.g. --key-columns id)."
            )
        key_columns = [col.strip() for col in args.key_columns.split(",") if col.strip()]
        if not key_columns:
            raise UnsafeSqlError("--key-columns must name at least one column.")
        set_columns = parse_update_set_columns(args.generate_rollback)
        if not set_columns:
            raise UnsafeSqlError("Could not parse the SET clause to build a rollback.")

    count_sql, snapshot_sql = derive_impact_sql(args, env, from_expr, where_expr, max_rows)

    source, sq_config, setup = prepare_source(args, config, env, env_name)
    try:
        count_cmd = build_sql_command(args, config, env, count_sql, source, sq_config, fmt="json")
        snapshot_cmd = build_sql_command(args, config, env, snapshot_sql, source, sq_config, fmt="json")

        if args.print_command:
            print_setup_prefix(setup, env)
            print(shlex.join(count_cmd))
            print(shlex.join(snapshot_cmd))
            return 0

        secrets = env_secrets(env)
        start = datetime.now()
        exit_code = None
        affected = None
        try:
            rc, affected, rows, err = run_impact(count_cmd, snapshot_cmd, secrets, args.timeout)
            if rc != 0:
                sys.stderr.write(err or "")
                exit_code = rc
                return rc
            if affected is None:
                raise UnsafeSqlError(
                    "Could not determine the affected-row count; refusing to build a rollback "
                    "without a completeness check."
                )
            if affected > len(rows):
                raise UnsafeSqlError(
                    f"Refusing to build a partial rollback: {affected} rows match but only "
                    f"{len(rows)} were captured (max_rows cap). Narrow the WHERE clause or raise max_rows."
                )

            if token == "update":
                rollback_sql = build_update_rollback(table, set_columns, key_columns, rows)
            else:
                rollback_sql = build_delete_rollback(table, rows)

            envelope = {
                "rollback": True,
                "token": token,
                "table": table,
                "where": where_expr,
                "affected_rows": affected,
                "key_columns": key_columns,
                "set_columns": set_columns,
                "executed": False,
                "rollback_sql": rollback_sql,
                "snapshot": rows,
            }
            print(json.dumps(envelope, ensure_ascii=False))
            exit_code = 0
            return 0
        finally:
            emit_audit(
                args, config, env, env_name,
                event="generate_rollback",
                statement=args.generate_rollback,
                token=token,
                allow_write=False,
                exit_code=exit_code,
                duration_ms=round((datetime.now() - start).total_seconds() * 1000, 1),
                extra={"affected_rows": affected},
            )
    finally:
        if isinstance(setup, tempfile.TemporaryDirectory):
            setup.cleanup()


def main():
    args = parse_args()

    try:
        if args.setup_status:
            print(json.dumps(setup_status(args), ensure_ascii=False))
            return 0

        if args.check_sql:
            _, token = validate_sql(args.check_sql, allow_write=args.allow_write)
            limited = maybe_add_limit(args.check_sql, token, args.limit, "limit", args.no_auto_limit)
            print(limited)
            return 0

        if args.list_envs:
            config, path = load_config(args.config)
            envs = config.get("environments", {})
            connections = [
                connection_summary(name, envs[name])
                for name in sorted(envs)
            ]
            print(json.dumps({"config": str(path), "environments": sorted(envs), "connections": connections}, ensure_ascii=False))
            return 0

        config, path, env_name, env = runtime_connection(args)
        enforce_readonly(config, env, env_name)
        max_rows = configured_max_rows(config, env)

        if args.preview_write:
            return preview_write(args, config, env, env_name, max_rows)

        if args.generate_rollback:
            return generate_rollback(args, config, env, env_name, max_rows)

        audit_event = None
        audit_statement = None
        audit_token = None

        if args.sql:
            _, token = validate_sql(args.sql, allow_write=args.allow_write)
            sql = maybe_add_limit_with_cap(
                args.sql,
                token,
                args.limit,
                env.get("limit_style", "limit"),
                args.no_auto_limit,
                max_rows,
            )
            source, sq_config, setup = prepare_source(args, config, env, env_name)
            cmd = build_sql_command(args, config, env, sql, source, sq_config)
            audit_event = "sql"
            audit_statement = sql
            audit_token = token
        elif args.search_objects:
            search_sql = build_search_objects_sql(env, args)
            _, token = validate_sql(search_sql, allow_write=False)
            sql = maybe_add_limit_with_cap(
                search_sql,
                token,
                args.limit,
                env.get("limit_style", "limit"),
                args.no_auto_limit,
                max_rows,
            )
            source, sq_config, setup = prepare_source(args, config, env, env_name)
            cmd = build_sql_command(args, config, env, sql, source, sq_config)
            audit_event = "search_objects"
            audit_statement = sql
            audit_token = token
        elif args.inspect is not None:
            source, sq_config, setup = prepare_source(args, config, env, env_name)
            cmd = build_inspect_command(args, config, env, source, sq_config)
            audit_event = "inspect"
            audit_statement = args.inspect or ""
        else:
            raise ConfigError("Provide --sql, --search-objects, --inspect, --list-envs, or --check-sql.")

        if args.print_command:
            if isinstance(setup, tuple):
                prefix, setup_cmd = setup
                print(prefix + redact(shlex.join(setup_cmd), env_secrets(env)))
                print("&&")
            elif isinstance(setup, list):
                print(redact(shlex.join(setup), env_secrets(env)))
                print("&&")
            print(shlex.join(cmd))
            return 0

        secrets = env_secrets(env)
        start = datetime.now()
        exit_code = None
        try:
            exit_code = run_command(cmd, args.timeout, secrets)
            return exit_code
        finally:
            emit_audit(
                args, config, env, env_name,
                event=audit_event,
                statement=audit_statement,
                token=audit_token,
                allow_write=args.allow_write,
                exit_code=exit_code,
                duration_ms=round((datetime.now() - start).total_seconds() * 1000, 1),
            )
            if isinstance(setup, tempfile.TemporaryDirectory):
                setup.cleanup()
    except (ConfigError, UnsafeSqlError, subprocess.TimeoutExpired) as exc:
        print(f"db-query: {exc}", file=sys.stderr)
        return 2
    except json.JSONDecodeError as exc:
        print(f"db-query: invalid config JSON: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
