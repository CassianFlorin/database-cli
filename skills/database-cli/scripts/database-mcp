                },
                "required": ["sql"],
                "additionalProperties": False,
            },
        },
    ]
    config, _ = load_config(config_path, required=False)
    tools = config.get("tools", {})
    if isinstance(tools, dict):
        for name, spec in sorted(tools.items()):
            if not is_valid_tool_name(name) or not isinstance(spec, dict):
                continue
            parameters = spec.get("parameters", {})
            properties = {"config": common_config}
            required = []
            if isinstance(parameters, dict):
                for param_name, param_spec in parameters.items():
                    if not is_valid_param_name(param_name):
                        continue
                    schema = parameter_schema(param_spec)
                    properties[param_name] = schema
                    if isinstance(param_spec, dict) and "default" not in param_spec and not param_spec.get("optional"):
                        required.append(param_name)
            properties["_format"] = {"type": "string", "enum": ["json", "csv", "markdown", "text", "yaml"]}
            properties["_limit"] = {"type": "integer", "minimum": 0}
            properties["_print_command"] = {"type": "boolean"}
            base_tools.append(
                {
                    "name": name,
                    "description": spec.get("description") or f"Run configured database-cli tool '{name}'.",
                    "inputSchema": {
                        "type": "object",
                        "properties": properties,
                        "required": required,
                        "additionalProperties": False,
                    },
                }
            )
    return base_tools


def is_valid_tool_name(name):
    return bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,63}", str(name)))


def is_valid_param_name(name):
    return bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(name)))


def parameter_schema(param_spec):
    if not isinstance(param_spec, dict):
        return {"type": "string"}
    schema = {"type": param_spec.get("type", "string")}
    if param_spec.get("description"):
        schema["description"] = param_spec["description"]
    if "enum" in param_spec:
        schema["enum"] = param_spec["enum"]
    if "minimum" in param_spec:
        schema["minimum"] = param_spec["minimum"]
    if "maximum" in param_spec:
        schema["maximum"] = param_spec["maximum"]
    return schema


def merged_connection_args(args):
    parsed = parse_database_url(args.get("url"))
    merged = dict(parsed)
    for key, value in args.items():
        if key in {"config", "url", "force"}:
            continue
        if value not in (None, "", [], {}):
            merged[key] = value
    return merged


def run_add_connection(args):
    merged = merged_connection_args(args)
    cmd = [str(INIT_CONFIG), "--env", args["env"], "--non-interactive"]
    if args.get("config"):
        cmd.extend(["--output", args["config"]])
    if args.get("force"):
        cmd.append("--force")

    option_names = {
        "display_name": "--display-name",
        "environment": "--environment",
        "project": "--project",
        "description": "--description",
        "driver": "--driver",
        "host": "--host",
        "port": "--port",
        "database": "--database",
        "path": "--path",
        "username": "--username",
        "password": "--password",
        "password_env": "--password-env",
        "schema": "--schema",
        "max_rows": "--max-rows",
        "limit_style": "--limit-style",
    }
    for key, option in option_names.items():
        if key in merged and merged[key] not in (None, ""):
            cmd.extend([option, str(merged[key])])
    for alias in merged.get("aliases", []) or []:
        if alias:
            cmd.extend(["--alias", str(alias)])

    try:
        proc = subprocess.run(
            cmd, text=True, stdin=subprocess.DEVNULL, capture_output=True,
            check=False, timeout=INIT_CONFIG_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return timeout_result("init-config", INIT_CONFIG_TIMEOUT)
    if proc.returncode == 0 and merged.get("params"):
        patch_connection_params(Path(args.get("config") or (SKILL_ROOT / "connections.local.json")), args["env"], merged["params"])
    return process_result(proc)


def patch_connection_params(path, env_name, params):
    path = path.expanduser()
    with path.open("r", encoding="utf-8") as handle:
        config = json.load(handle)
    config.setdefault("environments", {}).setdefault(env_name, {})["params"] = {
        str(key): str(value) for key, value in params.items()
    }
    with path.open("w", encoding="utf-8") as handle:
        json.dump(config, handle, indent=2, ensure_ascii=False)
        handle.write("\n")


def add_common_args(cmd, args):
    if args.get("config"):
        cmd.extend(["--config", args["config"]])
    if args.get("format"):
        cmd.extend(["--format", args["format"]])
    if args.get("limit") is not None:
        cmd.extend(["--limit", str(args["limit"])])
    if args.get("schema"):
        cmd.extend(["--schema", args["schema"]])
    if args.get("no_auto_limit"):
        cmd.append("--no-auto-limit")
    # Pin db-query's per-query timeout instead of inheriting its default, so
    # DB_QUERY_BACKSTOP is provably the looser of the two.
    cmd.extend(["--timeout", str(DB_QUERY_TIMEOUT)])


def add_connection_args(cmd, args):
    option_names = {
        "url": "--url",
        "driver": "--driver",
        "host": "--host",
        "port": "--port",
        "database": "--database",
        "path": "--path",
        "username": "--username",
        "password": "--password",
        "password_env": "--password-env",
        "max_rows": "--max-rows",
    }
    for key, option in option_names.items():
        if args.get(key) not in (None, ""):
            cmd.extend([option, str(args[key])])


def command_for_tool(name, args):
    cmd = [str(DB_QUERY)]
    if name == "setup_status":
        if args.get("config"):
            cmd.extend(["--config", args["config"]])
        if args.get("sq_bin"):
            cmd.extend(["--sq-bin", args["sq_bin"]])
        cmd.append("--setup-status")
        return cmd
    if name == "list_envs":
        if args.get("config"):
            cmd.extend(["--config", args["config"]])
        cmd.append("--list-envs")
        return cmd
    if name == "query_readonly":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--sql", args["sql"]])
        return cmd
    if name == "execute_sql":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("allow_write"):
            cmd.append("--allow-write")
        if args.get("writable"):
            cmd.append("--writable")
        if args.get("print_command"):
            cmd.append("--print-command")
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--sql", args["sql"]])
        return cmd
    if name == "preview_write":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("print_command"):
            cmd.append("--print-command")
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--preview-write", args["sql"]])
        return cmd
    if name == "generate_rollback":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("print_command"):
            cmd.append("--print-command")
        if args.get("key_columns"):
            cmd.extend(["--key-columns", args["key_columns"]])
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--generate-rollback", args["sql"]])
        return cmd
    if name == "repair":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("allow_write"):
            cmd.append("--allow-write")
        if args.get("writable"):
            cmd.append("--writable")
        if args.get("print_command"):
            cmd.append("--print-command")
        if args.get("key_columns"):
            cmd.extend(["--key-columns", args["key_columns"]])
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--repair", args["sql"]])
        return cmd
    if name == "inspect":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.append("--inspect")
        if args.get("target"):
            cmd.append(args["target"])
        return cmd
    if name == "search_objects":
        add_common_args(cmd, args)
        add_connection_args(cmd, args)
        if args.get("env"):
            cmd.extend(["--env", args["env"]])
        cmd.extend(["--search-objects", args["pattern"]])
        if args.get("object_type"):
            cmd.extend(["--object-type", args["object_type"]])
        if args.get("detail_level"):
            cmd.extend(["--detail-level", args["detail_level"]])
        if args.get("table"):
            cmd.extend(["--table", args["table"]])
        return cmd
    if name == "check_sql":
        if args.get("limit") is not None:
            cmd.extend(["--limit", str(args["limit"])])
        if args.get("no_auto_limit"):
            cmd.append("--no-auto-limit")
        if args.get("allow_write"):
            cmd.append("--allow-write")
        if args.get("writable"):
            cmd.append("--writable")
        cmd.extend(["--check-sql", args["sql"]])
        return cmd
    raise ValueError(f"Unknown tool '{name}'.")


def configured_driver(config, env_name):
    """Driver of a configured environment, resolving aliases the way db-query does.

    Returns "" when it cannot be determined; sql_literal then refuses exactly
    the values whose quoting depends on knowing it.
    """
    envs = config.get("environments", {})
    if not isinstance(envs, dict):
        return ""
    env = envs.get(env_name)
    if not isinstance(env, dict):
        matches = [
            candidate
            for candidate in envs.values()
            if isinstance(candidate, dict) and env_name in alias_values(candidate)
        ]
        if len(matches) != 1:
            return ""
        env = matches[0]
    return env_driver(env)


def sql_param_literal(value, driver):
    """Render a validated custom-tool parameter as a SQL literal.

    validate_custom_arg has already coerced the value, so the type domain here
    is narrower than a snapshot row's. The quoting itself is shared: it has to
    agree with db-query or the two entry points would emit different SQL for
    the same value.
    """
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, (int, float)):
        if isinstance(value, float) and not math.isfinite(value):
            raise ValueError(f"Parameter value {value!r} has no SQL literal form.")
        return str(value)
    return sql_literal(value, driver)


def validate_custom_arg(name, spec, value):
    if not isinstance(spec, dict):
        return value
    if value is None:
        return value
    if "enum" in spec and value not in spec["enum"]:
        allowed = ", ".join(str(item) for item in spec["enum"])
        raise ValueError(f"Parameter '{name}' must be one of: {allowed}.")
    expected = spec.get("type", "string")
    if expected == "integer":
        if isinstance(value, bool):
            raise ValueError(f"Parameter '{name}' must be an integer.")
        converted = int(value)
    elif expected == "number":
        if isinstance(value, bool):
            raise ValueError(f"Parameter '{name}' must be a number.")
        converted = float(value)
    elif expected == "boolean":
        if isinstance(value, bool):
            return value
        if str(value).lower() in {"true", "1", "yes"}:
            return True
        if str(value).lower() in {"false", "0", "no"}:
            return False
        raise ValueError(f"Parameter '{name}' must be a boolean.")
    else:
        return str(value)
    if "minimum" in spec and converted < spec["minimum"]:
        raise ValueError(f"Parameter '{name}' must be >= {spec['minimum']}.")
    if "maximum" in spec and converted > spec["maximum"]:
        raise ValueError(f"Parameter '{name}' must be <= {spec['maximum']}.")
    return converted


def render_custom_sql(spec, args, driver):
    sql = spec.get("sql")
    if not sql:
        raise ValueError("Configured tool is missing sql.")
    parameters = spec.get("parameters", {})
    values = {}
    if isinstance(parameters, dict):
        for name, param_spec in parameters.items():
            if not is_valid_param_name(name):
                continue
            if name in args:
                value = args[name]
            elif isinstance(param_spec, dict) and "default" in param_spec:
                value = param_spec["default"]
            elif isinstance(param_spec, dict) and param_spec.get("optional"):
                value = None
            else:
                raise ValueError(f"Missing required parameter '{name}'.")
            values[name] = validate_custom_arg(name, param_spec, value)

    def replace(match):
        name = match.group(1)
        if name not in values:
            raise ValueError(f"SQL references unknown parameter '{name}'.")
        return sql_param_literal(values[name], driver)

    return re.sub(r"(?<!:):([A-Za-z_][A-Za-z0-9_]*)", replace, sql)


def command_for_custom_tool(name, args):
    config, _ = load_config(args.get("config"), required=True)
    tools = config.get("tools", {})
    if name not in tools or not isinstance(tools[name], dict):
        raise ValueError(f"Unknown tool '{name}'.")
    spec = tools[name]
    env = spec.get("env") or args.get("env")
    if not env:
        raise ValueError(f"Configured tool '{name}' must define env.")
    sql = render_custom_sql(spec, args, configured_driver(config, env))
    cmd = [str(DB_QUERY)]
    if args.get("config"):
        cmd.extend(["--config", args["config"]])
    if args.get("_format"):
        cmd.extend(["--format", args["_format"]])
    if args.get("_limit") is not None:
        cmd.extend(["--limit", str(args["_limit"])])
    if spec.get("schema"):
        cmd.extend(["--schema", spec["schema"]])
    if args.get("_print_command"):
        cmd.append("--print-command")
    cmd.extend(["--timeout", str(DB_QUERY_TIMEOUT)])
    cmd.extend(["--env", env, "--sql", sql])
    return cmd


def run_tool(name, args):
    if name == "add_connection":
        return run_add_connection(args)
    try:
        cmd = command_for_tool(name, args)
    except ValueError:
        cmd = command_for_custom_tool(name, args)
    try:
        proc = subprocess.run(
            # Never let a child inherit the JSON-RPC pipe: it would block on, or
            # consume, the bytes the client is still sending us.
            cmd, text=True, stdin=subprocess.DEVNULL, capture_output=True,
            check=False, timeout=DB_QUERY_BACKSTOP,
        )
    except subprocess.TimeoutExpired:
        return timeout_result("db-query", DB_QUERY_BACKSTOP)
    return process_result(proc)


def timeout_result(what, timeout):
    """Report a timeout as a failed tool call.

    Never build this from the TimeoutExpired, which stringifies the whole
    command line: that can carry --password.
    """
    message = f"{what} exceeded {timeout}s and was terminated."
    return {
        "content": [{"type": "text", "text": message}],
        "structuredContent": {"exit_code": 124, "stdout": "", "stderr": message},
        "isError": True,
    }


def process_result(proc):
    text = proc.stdout
    if proc.stderr:
        text = text + ("\n" if text else "") + proc.stderr
    structured = {
        "exit_code": proc.returncode,
        "stdout": proc.stdout.strip(),
        "stderr": proc.stderr.strip(),
    }
    if proc.stdout.strip():
        try:
            structured["json"] = json.loads(proc.stdout)
        except json.JSONDecodeError:
            pass
    return {
        "content": [{"type": "text", "text": text.strip()}],
        "structuredContent": structured,
        "isError": proc.returncode != 0,
    }


def error_response(message, code=-32603):
    return {"jsonrpc": "2.0", "error": {"code": code, "message": message}}


def handle(message):
    if not isinstance(message, dict):
        return {
            "jsonrpc": "2.0",
            "id": None,
            "error": {"code": -32600, "message": "Request must be a JSON object."},
        }

    method = message.get("method")
    response = {"jsonrpc": "2.0"}
    if "id" in message:
        response["id"] = message["id"]

    try:
        if method == "initialize":
            response["result"] = {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "database-cli", "version": SERVER_VERSION},
            }
        elif method == "tools/list":
            params = message.get("params") or {}
            arguments = params.get("arguments") or {}
            response["result"] = {"tools": tool_schema(arguments.get("config"))}
        elif method == "tools/call":
            params = message.get("params") or {}
            response["result"] = run_tool(params["name"], params.get("arguments") or {})
        elif method and method.startswith("notifications/"):
            return None
        else:
            response["error"] = {"code": -32601, "message": f"Unknown method '{method}'."}
    except KeyError as exc:
        response["error"] = {"code": -32602, "message": f"Missing required field: {exc}"}
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        response["error"] = {"code": -32603, "message": str(exc)}
    except Exception as exc:  # one bad call must not take down a long-lived server
        response["error"] = {"code": -32603, "message": f"{type(exc).__name__}: {exc}"}
    return response


def read_message(stream):
    """Read one JSON-RPC message from a live stdio stream.

    Blocks only until the current message is complete, so each response goes
    out while the client keeps the pipe open. Framing is detected per message:
    a Content-Length header introduces a framed body, any other non-blank line
    is one NDJSON message. Returns (raw_body, framed), or (None, framed) at EOF.
    """
    while True:
        line = stream.readline()
        if not line:
            return None, False
        stripped = line.strip()
        if not stripped:
            continue

        if not stripped.lower().startswith(b"content-length:"):
            return stripped, False

        try:
            length = int(stripped.partition(b":")[2].strip())
        except ValueError as exc:
            raise ValueError(f"invalid Content-Length header: {stripped!r}") from exc
        if length < 0:
            raise ValueError(f"negative Content-Length: {length}")

        while True:  # drop the remaining headers up to the blank separator line
            header = stream.readline()
            if not header or not header.strip():
                break

        body = stream.read(length)
        if body is None or len(body) < length:
            return None, True
        return body, True


def write_response(response, framed):
    raw = json.dumps(response, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    if framed:
        sys.stdout.buffer.write(f"Content-Length: {len(raw)}\r\n\r\n".encode("ascii"))
        sys.stdout.buffer.write(raw)
    else:
        sys.stdout.buffer.write(raw + b"\n")
    sys.stdout.buffer.flush()


def serve(stream):
    """Serve JSON-RPC messages until the client closes the stream."""
    framed = False
    while True:
        try:
            raw, framed = read_message(stream)
        except ValueError as exc:
            # Framing is desynchronized; the rest of the stream is unusable.
            write_response(error_response(f"Invalid JSON-RPC framing: {exc}", -32700), framed)
            return
        if raw is None:
            return
        try:
            message = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            write_response(error_response(f"Invalid JSON-RPC input: {exc}", -32700), framed)
            continue
        response = handle(message)
        if response is not None and "id" in response:
            write_response(response, framed)


def main():
    try:
        serve(sys.stdin.buffer)
    except BrokenPipeError:
        pass  # the client went away mid-response
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
