#!/usr/bin/env python3
import json
import math
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _common import (  # noqa: E402  (path set above; these scripts are not a package)
    alias_values,
    env_driver,
    load_config,
    parse_database_url,
    sql_literal,
)


SKILL_ROOT = Path(__file__).resolve().parents[1]
DB_QUERY = SKILL_ROOT / "scripts" / "db-query"
INIT_CONFIG = SKILL_ROOT / "scripts" / "init-config"
SERVER_VERSION = "0.9.0"

# db-query applies DB_QUERY_TIMEOUT to every sq invocation it makes, and one
# call can make several: repair --allow-write runs source-add, count, snapshot,
# change, and post-check. The outer backstop is derived from that worst case so
# db-query's own timeout always fires first and reports which query stalled;
# the backstop only catches a db-query wedged before or between its sq calls.
DB_QUERY_TIMEOUT = 60
MAX_SQ_CALLS_PER_RUN = 5
DB_QUERY_BACKSTOP = DB_QUERY_TIMEOUT * MAX_SQ_CALLS_PER_RUN + 30
INIT_CONFIG_TIMEOUT = 30  # writes local config files, never touches the network


